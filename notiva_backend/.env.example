# NOTIVA Backend - Example Environment Variables
# Copy this file to .env and replace placeholders with real values for production.

# Django Settings
SECRET_KEY="your-super-secret-production-key"
DEBUG=False
ALLOWED_HOSTS="your-backend-domain.com,api.yourdomain.com"

# CORS & CSRF - Add your GitHub Pages frontend URL here
CORS_ALLOWED_ORIGINS="https://yourusername.github.io"
